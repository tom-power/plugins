<?xml version="1.0" encoding="UTF-8"?>
<!--
The <plugins> element (required) contains the description of the plugins
available at this repository.
-->
<plugins>
  <!--
  Each <plugin> element (required) describes one plugin in the repository.
  Attributes:
   - "id" (required) - used by JetBrains IDEs to uniquely identify
     a plugin. Must match <id> in the plugin.xml file.
   - "url" (required) - URL to download the plugin JAR/ZIP file.
     Must be HTTPS.
   - "version" (required) - version of this plugin. Must match <version>
     in the plugin.xml file.
  -->
  <plugin
          id="com.github.tom-power.terminal-agent-window"
          url="https://github.com/tom-power/terminal-agent-window/releases/latest/download/terminal-agent-window.zip"          
          version="0.1.0">
    <!--
    The <idea-version> element (required) must match the same element
    in the plugin.xml file.
    -->
    <name>Terminal Agent Window</name>
    <description>JetBrains IDE plugin that provides a terminal tool window for AI agents.</description>
    <vendor email="tp21@tuta.io" url="https://github.com/tom-power/terminal-agent-window">Tom Power</vendor>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <idea-version since-build="251"/>
  </plugin>>
</plugins>
